<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <% if (customers && customers.length> 0) { %>
        <% for (var i=0; i < customers.length; i++) { %>
            <tr>
                <td>
                    <%= i + 1 %>
                </td>
                <td>
                    <%= customers[i].name %>
                </td>
                <td>
                    <%= customers[i].address %>
                </td>
                <td>
                    <%= customers[i].phone %>
                </td>
                <td>
                    <a href="/update/<%= customers[i].id %>" class="btn btn-info">Edit</a>
                    <a href="/delete/<%= customers[i].id %>" class="btn btn-danger">Delete</a>
                </td>
            </tr>
            <% } %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="text-center">No customers found.</td>
                    </tr>
                    <% } %>

</body>

</html>